<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gengolearning.app">

    <application
        android:name="com.example.gengolearning.GengoLearning"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/main_launcher_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/main_launcher_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyLanguageLearningApp"
        android:localeConfig="@xml/locales_config">
        <activity
            android:name="com.example.gengolearning.ui.features.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyLanguageLearningApp"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true"/>
        </service>
    </application>

</manifest>